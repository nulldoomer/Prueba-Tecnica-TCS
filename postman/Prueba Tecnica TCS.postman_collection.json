            {
              "name": "Crear cliente Jose Lema",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set(\"joseIdentificacion\", \"17\" + String(Math.floor(Math.random() * 1e8)).padStart(8, \"0\"));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                      "const json = pm.response.json();",
                      "pm.test(\"success = true\", () => pm.expect(json.success).to.eql(true));",
                      "pm.test(\"Nombre = Jose Lema\", () => pm.expect(json.result.nombre).to.eql(\"Jose Lema\"));",
                      "pm.test(\"No expone la contrasena\", () => pm.expect(json.result).to.not.have.property(\"contrasena\"));",
                      "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));",
                      "pm.collectionVariables.set(\"joseId\", json.result.clienteId);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"MASCULINO\",\n  \"edad\": 35,\n  \"identificacion\": \"{{joseIdentificacion}}\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}",
